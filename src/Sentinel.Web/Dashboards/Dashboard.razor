@page "/"

@layout Base

<header
    class="sticky top-0 z-30 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-100 dark:border-slate-800 px-4 sm:px-8 py-4 sm:py-5 flex flex-wrap items-center justify-between gap-3 transition-colors">
    <div class="flex items-center gap-3">
        <div
            class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white shadow-md shadow-purple-500/20">
            <i class="fa-solid fa-heart text-lg"></i>
        </div>
        <div>
            <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                Sentinel: X
            </h1>
        </div>
    </div>

    <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
        <button id="refreshBtn" onclick="manualRefresh()" title="Refresh status now"
                class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none">
            <i id="refreshIcon" class="fa-solid fa-rotate-right text-sm"></i>
        </button>

        <div
            class="flex items-center gap-2 bg-slate-100/90 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60 rounded-full px-3 py-1.5 text-xs font-medium text-slate-600 dark:text-slate-300">
                    <span class="relative flex h-2 w-2">
                      <span
                          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                    </span>
            <span class="hidden sm:inline">Auto-refresh every 15s</span>
            <span class="sm:hidden">15s</span>
            <span id="countdownTimer"
                  class="font-semibold text-slate-800 dark:text-slate-100 font-mono-custom hidden">15</span>
        </div>

        <div
            class="flex items-center bg-slate-100 dark:bg-slate-800/90 border border-slate-200/80 dark:border-slate-700/80 p-1 rounded-full text-xs text-slate-500 dark:text-slate-400 shadow-inner">
            <button onclick="setTheme('light')" id="theme-btn-light" title="Light mode"
                    class="theme-toggle-btn px-2.5 py-1 rounded-full flex items-center gap-1.5 transition-all focus:outline-none">
                <i class="fa-solid fa-sun text-[11px]"></i>
                <span class="text-[11px] font-medium hidden md:inline">Light</span>
            </button>

            <button onclick="setTheme('system')" id="theme-btn-system" title="Follow system theme"
                    class="theme-toggle-btn px-2.5 py-1 rounded-full flex items-center gap-1.5 transition-all focus:outline-none">
                <i class="fa-solid fa-desktop text-[11px]"></i>
                <span class="text-[11px] font-medium hidden md:inline">System</span>
            </button>

            <button onclick="setTheme('dark')" id="theme-btn-dark" title="Dark mode"
                    class="theme-toggle-btn px-2.5 py-1 rounded-full flex items-center gap-1.5 transition-all focus:outline-none">
                <i class="fa-solid fa-moon text-[11px]"></i>
                <span class="text-[11px] font-medium hidden md:inline">Dark</span>
            </button>
        </div>
    </div>
</header>

<div
    class="bg-slate-50/70 dark:bg-slate-900/60 border-b border-slate-200/70 dark:border-slate-800/80 px-4 sm:px-8 py-3.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 flex-shrink-0 transition-colors">
    <!-- Service Path -->
    <div class="flex items-center gap-2 font-mono-custom text-xs sm:text-sm">
                <span
                    class="font-bold text-slate-700 dark:text-slate-200 bg-slate-200/80 dark:bg-slate-800 px-2 py-0.5 rounded text-xs tracking-wide">API</span>
        <span class="text-slate-500 dark:text-slate-400 font-medium">/health/ready</span>
    </div>

    <!-- Filter Pills & Status Badge -->
    <div class="flex items-center justify-between sm:justify-end w-full sm:w-auto gap-3">
        <!-- Quick Filter Tabs -->
        <div
            class="flex items-center bg-slate-200/60 dark:bg-slate-800/80 p-0.5 rounded-lg text-xs font-medium text-slate-600 dark:text-slate-400">
            <button onclick="filterStatus('all')" id="filter-all"
                    class="filter-tab px-2.5 py-1 rounded-md bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm transition-all">
                All
            </button>
            <button onclick="filterStatus('healthy')" id="filter-healthy"
                    class="filter-tab px-2.5 py-1 rounded-md hover:text-slate-900 dark:hover:text-white transition-all">
                Healthy
            </button>
            <button onclick="filterStatus('degraded')" id="filter-degraded"
                    class="filter-tab px-2.5 py-1 rounded-md hover:text-slate-900 dark:hover:text-white transition-all">
                Degraded
            </button>
            <button onclick="filterStatus('unhealthy')" id="filter-unhealthy"
                    class="filter-tab px-2.5 py-1 rounded-md hover:text-slate-900 dark:hover:text-white transition-all">
                Unhealthy
            </button>
        </div>

        <!-- Overall API Status Pill -->
        <div id="overallBadge"
             class="flex items-center gap-1.5 bg-emerald-100/80 dark:bg-emerald-950/60 border border-emerald-300/60 dark:border-emerald-800/60 text-emerald-700 dark:text-emerald-400 font-bold px-3 py-1 rounded-full text-xs uppercase tracking-wider shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Healthy</span>
        </div>
    </div>
</div>

<!-- Sticky Table Grid Column Headers -->
<div
    class="sticky top-0 z-20 bg-white dark:bg-slate-900 border-b border-slate-200/80 dark:border-slate-800/80 px-4 sm:px-8 py-3 grid grid-cols-12 gap-4 text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider flex-shrink-0 transition-colors">
    <div class="col-span-6 sm:col-span-6 flex items-center">Check</div>
    <div class="col-span-3 sm:col-span-4 flex items-center justify-start">Status</div>
    <div class="col-span-3 sm:col-span-2 flex items-center justify-end">Duration</div>
</div>

<!-- Scrollable Container List (Flex/Grid rows - NO <table>) -->
<div id="healthCheckList" class="overflow-y-auto flex-1 divide-y divide-slate-100 dark:divide-slate-800/60">

    <!-- Row 1: postgres (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-4 sm:px-8 py-4 items-center hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base font-mono-custom">
                postgres
            </div>
            <div class="text-xs text-slate-400 dark:text-slate-500 font-mono-custom mt-0.5">tags: [ ready ]
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold text-sm">Healthy</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            41 ms
        </div>
    </div>

    <!-- Row 2: redis (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-4 sm:px-8 py-4 items-center hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base font-mono-custom">
                redis
            </div>
            <div class="text-xs text-slate-400 dark:text-slate-500 font-mono-custom mt-0.5">PING ok · tags: [
                ready ]
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold text-sm">Healthy</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            6 ms
        </div>
    </div>

    <!-- Row 3: blog (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-4 sm:px-8 py-4 items-center hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base font-mono-custom">
                blog
            </div>
            <div
                class="text-xs text-slate-400 dark:text-slate-500 font-mono-custom mt-0.5 hover:underline cursor-pointer">
                https://codewithmukesh.com
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold text-sm">Healthy</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            88 ms
        </div>
    </div>

    <!-- Row 4: payment-gateway (Degraded - Highlighted) -->
    <div
        class="check-row degraded grid grid-cols-12 gap-4 px-4 sm:px-8 py-4 items-center bg-amber-50/60 dark:bg-amber-950/20 hover:bg-amber-50 dark:hover:bg-amber-950/30 border-l-4 border-l-amber-500 transition-colors">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base font-mono-custom">
                payment-gateway
            </div>
            <div class="text-xs text-amber-700/80 dark:text-amber-400/90 font-mono-custom mt-0.5">Gateway slow:
                820 ms - still serving
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 flex-shrink-0"></span>
            <span class="text-amber-700 dark:text-amber-400 font-semibold text-sm">Degraded</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-amber-700 dark:text-amber-400 font-medium">
            820 ms
        </div>
    </div>

    <!-- Row 5: auth-service (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-4 sm:px-8 py-4 items-center hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base font-mono-custom">
                auth-service
            </div>
            <div class="text-xs text-slate-400 dark:text-slate-500 font-mono-custom mt-0.5">JWT validation ·
                OAuth2 active
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold text-sm">Healthy</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            18 ms
        </div>
    </div>

    <!-- Row 6: rabbitmq (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-4 sm:px-8 py-4 items-center hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base font-mono-custom">
                rabbitmq
            </div>
            <div class="text-xs text-slate-400 dark:text-slate-500 font-mono-custom mt-0.5">Queues: 4 idle · 0
                backed up
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold text-sm">Healthy</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            12 ms
        </div>
    </div>

    <!-- Row 7: elasticsearch (Degraded - Highlighted) -->
    <div
        class="check-row degraded grid grid-cols-12 gap-4 px-4 sm:px-8 py-4 items-center bg-amber-50/60 dark:bg-amber-950/20 hover:bg-amber-50 dark:hover:bg-amber-950/30 border-l-4 border-l-amber-500 transition-colors">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base font-mono-custom">
                elasticsearch
            </div>
            <div class="text-xs text-amber-700/80 dark:text-amber-400/90 font-mono-custom mt-0.5">High heap
                memory usage (88%)
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 flex-shrink-0"></span>
            <span class="text-amber-700 dark:text-amber-400 font-semibold text-sm">Degraded</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-amber-700 dark:text-amber-400 font-medium">
            512 ms
        </div>
    </div>

    <!-- Row 8: storage-s3-bucket (Unhealthy - Red Highlighted) -->
    <div
        class="check-row unhealthy grid grid-cols-12 gap-4 px-4 sm:px-8 py-4 items-center bg-rose-50/60 dark:bg-rose-950/20 hover:bg-rose-50 dark:hover:bg-rose-950/30 border-l-4 border-l-rose-500 transition-colors">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base font-mono-custom">
                storage-s3-bucket
            </div>
            <div class="text-xs text-rose-700/80 dark:text-rose-400/90 font-mono-custom mt-0.5">Connection
                timeout (retried 3x)
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 flex-shrink-0 animate-pulse"></span>
            <span class="text-rose-700 dark:text-rose-400 font-semibold text-sm">Unhealthy</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-rose-700 dark:text-rose-400 font-medium">
            3004 ms
        </div>
    </div>

    <!-- Row 9: worker-node-01 (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-4 sm:px-8 py-4 items-center hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base font-mono-custom">
                worker-node-01
            </div>
            <div class="text-xs text-slate-400 dark:text-slate-500 font-mono-custom mt-0.5">CPU 14% · Memory
                3.2GB / 16GB
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold text-sm">Healthy</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            34 ms
        </div>
    </div>

    <!-- Row 10: mailer-service (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-4 sm:px-8 py-4 items-center hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base font-mono-custom">
                mailer-service
            </div>
            <div class="text-xs text-slate-400 dark:text-slate-500 font-mono-custom mt-0.5">SMTP handshake ok
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold text-sm">Healthy</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500 dark:text-slate-400">
            62 ms
        </div>
    </div>
</div>

<footer
    class="bg-slate-50 dark:bg-slate-950 border-t border-slate-200/80 dark:border-slate-800/80 px-4 sm:px-8 py-3 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 font-medium flex-shrink-0 transition-colors">
    <div>Total checks: <span id="totalCount" class="font-bold text-slate-700 dark:text-slate-200">10</span>
    </div>
    <div class="flex items-center gap-3 sm:gap-4">
        <span class="flex items-center gap-1.5"><span
                class="w-2 h-2 rounded-full bg-emerald-500"></span> 7 Healthy</span>
        <span class="flex items-center gap-1.5"><span
                class="w-2 h-2 rounded-full bg-amber-500"></span> 2 Degraded</span>
        <span class="flex items-center gap-1.5"><span
                class="w-2 h-2 rounded-full bg-rose-500"></span> 1 Unhealthy</span>
    </div>
</footer>

