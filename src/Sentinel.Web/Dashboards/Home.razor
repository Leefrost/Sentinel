@page "/"

@layout Base

<!-- Endpoint Bar & Quick Filters -->
<div
    class="bg-slate-50/70 border-b border-slate-200/70 px-6 sm:px-8 py-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 flex-shrink-0">
    <!-- Service Path -->
    <div class="flex items-center gap-2.5 font-mono-custom text-sm">
                    <span
                        class="font-bold text-slate-700 bg-slate-200/80 px-2 py-0.5 rounded text-xs tracking-wide">API</span>
        <span class="text-slate-500 font-medium">/health/ready</span>
    </div>

    <!-- Filter Pills & Status Badge -->
    <div class="flex items-center justify-between sm:justify-end w-full sm:w-auto gap-4">
        <!-- Quick Filter Tabs -->
        <div class="flex items-center bg-slate-200/60 p-0.5 rounded-lg text-xs font-medium text-slate-600">
            <button onclick="filterStatus('all')" id="filter-all"
                    class="filter-tab px-2.5 py-1 rounded-md bg-white text-slate-900 shadow-sm transition-all">
                All
            </button>
            <button onclick="filterStatus('healthy')" id="filter-healthy"
                    class="filter-tab px-2.5 py-1 rounded-md hover:text-slate-900 transition-all">Healthy
            </button>
            <button onclick="filterStatus('degraded')" id="filter-degraded"
                    class="filter-tab px-2.5 py-1 rounded-md hover:text-slate-900 transition-all">Degraded
            </button>
            <button onclick="filterStatus('unhealthy')" id="filter-unhealthy"
                    class="filter-tab px-2.5 py-1 rounded-md hover:text-slate-900 transition-all">Unhealthy
            </button>
        </div>

        <!-- Overall API Status Pill -->
        <div id="overallBadge"
             class="flex items-center gap-1.5 bg-emerald-100/80 border border-emerald-300/60 text-emerald-700 font-bold px-3 py-1 rounded-full text-xs uppercase tracking-wider shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Healthy</span>
        </div>
    </div>
</div>

<!-- Sticky Table Grid Column Headers -->
<div
    class="sticky top-0 z-20 bg-white border-b border-slate-200/80 px-6 sm:px-8 py-3 grid grid-cols-12 gap-4 text-[11px] font-bold text-slate-400 uppercase tracking-wider flex-shrink-0">
    <div class="col-span-6 sm:col-span-6 flex items-center">Check</div>
    <div class="col-span-3 sm:col-span-4 flex items-center justify-start sm:justify-start">Status</div>
    <div class="col-span-3 sm:col-span-2 flex items-center justify-end">Duration</div>
</div>

<!-- Scrollable Container List (Flex/Grid rows - NO <table>) -->
<div id="healthCheckList" class="overflow-y-auto flex-1 divide-y divide-slate-100">

    <!-- Row 1: postgres (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-6 sm:px-8 py-4 items-center hover:bg-slate-50/80 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 text-sm sm:text-base font-mono-custom">postgres</div>
            <div class="text-xs text-slate-400 font-mono-custom mt-0.5">tags: [ ready ]</div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 font-semibold text-sm">Healthy</span>
        </div>
        <div class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500">
            41 ms
        </div>
    </div>

    <!-- Row 2: redis (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-6 sm:px-8 py-4 items-center hover:bg-slate-50/80 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 text-sm sm:text-base font-mono-custom">redis</div>
            <div class="text-xs text-slate-400 font-mono-custom mt-0.5">PING ok · tags: [ ready ]</div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 font-semibold text-sm">Healthy</span>
        </div>
        <div class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500">
            6 ms
        </div>
    </div>

    <!-- Row 3: blog (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-6 sm:px-8 py-4 items-center hover:bg-slate-50/80 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 text-sm sm:text-base font-mono-custom">blog</div>
            <div class="text-xs text-slate-400 font-mono-custom mt-0.5 hover:underline cursor-pointer">
                https://codewithmukesh.com
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 font-semibold text-sm">Healthy</span>
        </div>
        <div class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500">
            88 ms
        </div>
    </div>

    <!-- Row 4: payment-gateway (Degraded - Highlighted) -->
    <div
        class="check-row degraded grid grid-cols-12 gap-4 px-6 sm:px-8 py-4 items-center bg-amber-50/60 hover:bg-amber-50 border-l-4 border-l-amber-500 transition-colors">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 text-sm sm:text-base font-mono-custom">payment-gateway
            </div>
            <div class="text-xs text-amber-700/80 font-mono-custom mt-0.5">Gateway slow: 820 ms - still
                serving
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 flex-shrink-0"></span>
            <span class="text-amber-700 font-semibold text-sm">Degraded</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-amber-700 font-medium">
            820 ms
        </div>
    </div>

    <!-- Row 5: auth-service (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-6 sm:px-8 py-4 items-center hover:bg-slate-50/80 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 text-sm sm:text-base font-mono-custom">auth-service</div>
            <div class="text-xs text-slate-400 font-mono-custom mt-0.5">JWT validation · OAuth2 active</div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 font-semibold text-sm">Healthy</span>
        </div>
        <div class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500">
            18 ms
        </div>
    </div>

    <!-- Row 6: rabbitmq (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-6 sm:px-8 py-4 items-center hover:bg-slate-50/80 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 text-sm sm:text-base font-mono-custom">rabbitmq</div>
            <div class="text-xs text-slate-400 font-mono-custom mt-0.5">Queues: 4 idle · 0 backed up</div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 font-semibold text-sm">Healthy</span>
        </div>
        <div class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500">
            12 ms
        </div>
    </div>

    <!-- Row 7: elasticsearch (Degraded - Highlighted) -->
    <div
        class="check-row degraded grid grid-cols-12 gap-4 px-6 sm:px-8 py-4 items-center bg-amber-50/60 hover:bg-amber-50 border-l-4 border-l-amber-500 transition-colors">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 text-sm sm:text-base font-mono-custom">elasticsearch</div>
            <div class="text-xs text-amber-700/80 font-mono-custom mt-0.5">High heap memory usage (88%)
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 flex-shrink-0"></span>
            <span class="text-amber-700 font-semibold text-sm">Degraded</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-amber-700 font-medium">
            512 ms
        </div>
    </div>

    <!-- Row 8: storage-s3-bucket (Unhealthy - Red Highlighted) -->
    <div
        class="check-row unhealthy grid grid-cols-12 gap-4 px-6 sm:px-8 py-4 items-center bg-rose-50/60 hover:bg-rose-50 border-l-4 border-l-rose-500 transition-colors">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 text-sm sm:text-base font-mono-custom">storage-s3-bucket
            </div>
            <div class="text-xs text-rose-700/80 font-mono-custom mt-0.5">Connection timeout (retried 3x)
            </div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 flex-shrink-0 animate-pulse"></span>
            <span class="text-rose-700 font-semibold text-sm">Unhealthy</span>
        </div>
        <div
            class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-rose-700 font-medium">
            3004 ms
        </div>
    </div>

    <!-- Row 9: worker-node-01 (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-6 sm:px-8 py-4 items-center hover:bg-slate-50/80 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 text-sm sm:text-base font-mono-custom">worker-node-01</div>
            <div class="text-xs text-slate-400 font-mono-custom mt-0.5">CPU 14% · Memory 3.2GB / 16GB</div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 font-semibold text-sm">Healthy</span>
        </div>
        <div class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500">
            34 ms
        </div>
    </div>

    <!-- Row 10: mailer-service (Healthy) -->
    <div
        class="check-row healthy grid grid-cols-12 gap-4 px-6 sm:px-8 py-4 items-center hover:bg-slate-50/80 transition-colors border-l-4 border-l-transparent">
        <div class="col-span-6 sm:col-span-6">
            <div class="font-bold text-slate-900 text-sm sm:text-base font-mono-custom">mailer-service</div>
            <div class="text-xs text-slate-400 font-mono-custom mt-0.5">SMTP handshake ok</div>
        </div>
        <div class="col-span-3 sm:col-span-4 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <span class="text-emerald-600 font-semibold text-sm">Healthy</span>
        </div>
        <div class="col-span-3 sm:col-span-2 text-right font-mono-custom text-xs sm:text-sm text-slate-500">
            62 ms
        </div>
    </div>

</div>
